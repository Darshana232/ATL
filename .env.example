# ===========================================================================
# ATL-India - example environment file
#
# HOW TO USE:  cp .env.example .env   then fill in the values.
#
# .env is gitignored and must NEVER be committed. This file is the committed
# *shape* of our configuration - real values live only on your machine and in
# your hosting provider's secret store.
#
# Every variable here is validated by Zod at startup (apps/api/src/config.ts).
# A missing or malformed value stops the process immediately with a clear
# message, instead of failing mysteriously on request #4000 in production.
# ===========================================================================

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=8080
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# --- Database ------------------------------------------------------------
# TWO ROLES, ON PURPOSE (least privilege - see migration 0005):
#
#   DATABASE_URL        the SERVICE. Connects as `atl_app`, which has
#                       SELECT/INSERT broadly, UPDATE only where a real
#                       lifecycle exists, and NO delete, truncate or DDL
#                       anywhere. The application cannot rewrite the audit
#                       trail even if its code is compromised.
#
#   DATABASE_ADMIN_URL  MIGRATIONS ONLY. Connects as the database owner, which
#                       has DDL rights. Optional - falls back to DATABASE_URL,
#                       but then least privilege is not in effect and the
#                       migration runner warns about it.
#
# The atl_app role is created by migration 0005. Homebrew PostgreSQL uses trust
# authentication for local connections, so no password is needed locally; a
# real deployment assigns credentials out of band.
#
# Find your owner username with:  whoami
DATABASE_URL=postgres://atl_app@localhost:5432/atl_india_dev
DATABASE_ADMIN_URL=postgres://REPLACE_WITH_YOUR_USERNAME@localhost:5432/atl_india_dev

# --- Anthropic (needed from Phase 8: agent runtime) ----------------------
# Leave blank until then; config treats it as optional.
ANTHROPIC_API_KEY=

# --- Razorpay TEST MODE ONLY (needed from Phase 7, optional) -------------
# Test-mode keys start with rzp_test_. NEVER put live keys in this project.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Payment authorization vouchers (needed from Phase 5) ----------------
# Signs the single-use token that the policy engine mints on PASS and that the
# payment service requires before it will capture money.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOUCHER_SIGNING_SECRET=
